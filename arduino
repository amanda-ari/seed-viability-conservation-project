void telemetryDelay(unsigned long durationMs) {
  unsigned long start = millis();

  while (millis() - start < durationMs) {
    enforceHeatingInterlock();
    sendTelemetry(false);
    responsiveDelay(25);
  }
}

// ==================================================
// SENSORS
// ==================================================
float readHumidity() {
  responsiveDelay(2000); // DHT22 minimum practical read interval
  return dht.readHumidity();
}

float readDefaultTemperature() {
  defaultTempSensor.requestTemperatures();
  return defaultTempSensor.getTempCByIndex(0);
}

float readStandbyTemperature() {
  standbyTempSensor.requestTemperatures();
  return standbyTempSensor.getTempCByIndex(0);
}

bool validTemperature(float temperature) {
  return temperature != DEVICE_DISCONNECTED_C &&
         temperature >= -100.0 &&
         temperature <= 125.0;
}

// ==================================================
// SERVO FUNCTIONS
// ==================================================
void openDefaultDoorSmoothly() {
  stopDefaultHeating();

  for (int angle = DEFAULT_DOOR_CLOSED;
       angle >= DEFAULT_DOOR_OPEN;
       angle--) {
    defaultServo.write(angle);
    responsiveDelay(SERVO_STEP_DELAY_DEFAULT);
  }
}

void closeDefaultDoorSmoothly() {
  for (int angle = DEFAULT_DOOR_OPEN;
       angle <= DEFAULT_DOOR_CLOSED;
       angle++) {
    defaultServo.write(angle);
    responsiveDelay(SERVO_STEP_DELAY_DEFAULT);
  }
}

void openStandbyDoorSmoothly() {
  stopStandbyHeating();

  for (int angle = STANDBY_DOOR_CLOSED;
       angle <= STANDBY_DOOR_OPEN;
       angle++) {
    standbyServo.write(angle);
    responsiveDelay(SERVO_STEP_DELAY_STANDBY);
  }
}

void closeStandbyDoorSmoothly() {
  if (!standbyDoorOpen) {
    standbyServo.write(STANDBY_DOOR_CLOSED);
    return;
  }

  for (int angle = STANDBY_DOOR_OPEN;
       angle >= STANDBY_DOOR_CLOSED;
       angle--) {
    standbyServo.write(angle);
    responsiveDelay(SERVO_STEP_DELAY_STANDBY);
  }
}

