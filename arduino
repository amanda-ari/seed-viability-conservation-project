}

void stopDefaultMotor() {
  digitalWrite(DEFAULT_MOTOR_IN3, LOW);
  digitalWrite(DEFAULT_MOTOR_IN4, LOW);
}

void moveStandbyIn() {
  digitalWrite(STANDBY_MOTOR_IN3, LOW);
  digitalWrite(STANDBY_MOTOR_IN4, HIGH);
}

void moveStandbyOut() {
  digitalWrite(STANDBY_MOTOR_IN3, HIGH);
  digitalWrite(STANDBY_MOTOR_IN4, LOW);
}

void stopStandbyMotor() {
  digitalWrite(STANDBY_MOTOR_IN3, LOW);
  digitalWrite(STANDBY_MOTOR_IN4, LOW);
}

// ==================================================
// HEATING OUTPUTS - ACTIVE LOW
// ==================================================
void startDefaultHeating() {
  stopStandbyHeating();
  digitalWrite(DEFAULT_PTC_PIN, LOW);
  digitalWrite(DEFAULT_FAN_PIN, LOW);
  defaultHeatingActive = true;
  enforceHeatingInterlock();
}

void stopDefaultHeating() {
  digitalWrite(DEFAULT_PTC_PIN, HIGH);
  digitalWrite(DEFAULT_FAN_PIN, HIGH);
  defaultHeatingActive = false;
}

void startStandbyHeating() {
  if (defaultHeatingActive ||
      digitalRead(DEFAULT_PTC_PIN) == LOW ||
      digitalRead(DEFAULT_LIMIT_IN) != LOW) {
    stopStandbyHeating();
    Serial.println("STANDBY heater start blocked");
    return;
  }

  digitalWrite(STANDBY_PTC_PIN, LOW);
  digitalWrite(STANDBY_FAN_PIN, LOW);
  standbyHeatingActive = true;
  enforceHeatingInterlock();
}

void stopStandbyHeating() {
  digitalWrite(STANDBY_PTC_PIN, HIGH);
  digitalWrite(STANDBY_FAN_PIN, HIGH);
  standbyHeatingActive = false;
}

void enforceHeatingInterlock() {
  bool defaultOutputOn = digitalRead(DEFAULT_PTC_PIN) == LOW;
  bool standbyOutputOn = digitalRead(STANDBY_PTC_PIN) == LOW;

  if ((defaultHeatingActive && standbyHeatingActive) ||
      (defaultOutputOn && standbyOutputOn)) {
    Serial.println("CRITICAL: Both heaters ON; stopping STANDBY");
    stopStandbyHeating();
  }
}

// ==================================================
// LIMITS / HOMING
// ==================================================
bool waitForLimit(
    int limitPin,
    unsigned long timeout,
    const char* limitName) {

  unsigned long startedAt = millis();

  while (digitalRead(limitPin) != LOW) {
    serviceAuxiliaryControls();
    enforceHeatingInterlock();
    sendTelemetry(false);

    if (millis() - startedAt >= timeout) {
      Serial.print("TIMEOUT waiting for ");
      Serial.println(limitName);
      return false;
    }

    responsiveDelay(10);
  }

  Serial.print(limitName);
  Serial.println(" limit reached");
  return true;
}

void homeBothTrays() {
  stopDefaultHeating();
  stopStandbyHeating();
  ensureBothDoorsClosed();

  if (digitalRead(DEFAULT_LIMIT_IN) != LOW) {
    Serial.println("Homing DEFAULT tray IN");
    moveDefaultIn();
    waitForLimit(DEFAULT_LIMIT_IN,
                 MOTOR_TRAVEL_TIMEOUT,
                 "DEFAULT IN");
    stopDefaultMotor();
  } else {
    stopDefaultMotor();
  }

  if (digitalRead(STANDBY_LIMIT_IN) != LOW) {
    Serial.println("Homing STANDBY tray IN");
    moveStandbyIn();
    waitForLimit(STANDBY_LIMIT_IN,
                 MOTOR_TRAVEL_TIMEOUT,
                 "STANDBY IN");
    stopStandbyMotor();
  } else {
    stopStandbyMotor();
  }

  responsiveDelay(LIMIT_SETTLE_TIME);
}

void returnStandbyToHumidityControl() {
  stopStandbyHeating();
  stopStandbyMotor();

  if (digitalRead(STANDBY_LIMIT_IN) != LOW) {
    moveStandbyIn();
    waitForLimit(STANDBY_LIMIT_IN,
                 MOTOR_TRAVEL_TIMEOUT,
                 "STANDBY IN");
    stopStandbyMotor();
  }

  closeStandbyDoorSmoothly();
  standbyDoorOpen = false;
}

void ensureBothDoorsClosed() {
  defaultServo.write(DEFAULT_DOOR_CLOSED);
  defaultDoorOpen = false;

  if (standbyDoorOpen) {
    closeStandbyDoorSmoothly();
  } else {
    standbyServo.write(STANDBY_DOOR_CLOSED);
  }

  standbyDoorOpen = false;
}

// ==================================================
// AUXILIARY BACKGROUND SERVICE
// Keeps lock, RFID, buzzer and manual tray responsive
// even while the silica-gel controller is busy.
// ==================================================
void serviceAuxiliaryControls() {
  if (!auxiliaryControlsReady) {
    return;
  }

  lockPeltierButton.tick();
  servicePeltierTemperatureControl();
  handleRFID();
  handleTrayControls();
  handleLimitSwitches();
  handleBuzzer();
  handleTemporaryRFIDUnlock();
  serviceNewHeatingSystem();
  updateLCD();
  serviceAirCleaning();
}

void responsiveDelay(unsigned long durationMs) {
  unsigned long startedAt = millis();

  while (millis() - startedAt < durationMs) {
    serviceAuxiliaryControls();
    enforceHeatingInterlock();
    sendTelemetry(false);
    delay(1);
  }
}

// =====================================================
// PELTIER CONTROL - ACTIVE LOW
// =====================================================
void turnPeltierOff() {
  digitalWrite(PELTIER_PIN, HIGH);

  if (peltierOutputOn) {
    Serial.println("Peltier OFF");
  }

  peltierOutputOn = false;
}

void turnPeltierOn() {
  // Absolute safety interlock: Peltier is only active when the lock is locked.
  if (!doorLocked || !peltierControlEnabled) {
    turnPeltierOff();
    return;
  }

  digitalWrite(PELTIER_PIN, LOW);

  if (!peltierOutputOn) {
    Serial.println("Peltier ON");
  }

  peltierOutputOn = true;
}

void servicePeltierTemperatureControl() {
  // Peltier is only active when the lock is locked.
  if (!doorLocked || !peltierControlEnabled) {
    turnPeltierOff();
    return;
  }

  unsigned long now = millis();
  if (now - lastPeltierTemperatureCheckMs < PELTIER_TEMP_CHECK_INTERVAL) {
    return;
  }

  lastPeltierTemperatureCheckMs = now;
  float temperature = dht.readTemperature();

  if (isnan(temperature)) {
    Serial.println("ERROR: DHT22 temperature read failed; Peltier OFF");
    turnPeltierOff();
    return;
  }

  latestMainTemperature = temperature;
  Serial.print("Main DHT22 temperature: ");
  Serial.print(temperature, 2);
  Serial.println(" C");

  // Hysteresis: ON above threshold, OFF one degree below threshold.
  if (!peltierOutputOn && temperature > PELTIER_TEMP_THRESHOLD) {
    turnPeltierOn();
  } else if (peltierOutputOn &&
             temperature <= PELTIER_TEMP_THRESHOLD - PELTIER_TEMP_HYSTERESIS) {
    turnPeltierOff();
  }
}

// Quick press toggles automatic Peltier permission.
void handlePeltierQuickPress() {
  if (peltierControlEnabled) {
    peltierControlEnabled = false;
    turnPeltierOff();
    Serial.println("Peltier control DISABLED. Lock can now be used.");
    shortBeep();
    return;
  }

  // Peltier is only active when the lock is locked.
  if (!doorLocked) {
    turnPeltierOff();
    Serial.println("Lock the system before enabling the Peltier!");
    soundAlarm();
    return;
  }

  peltierControlEnabled = true;
  lastPeltierTemperatureCheckMs = 0;
  Serial.println("Peltier automatic temperature control ENABLED");
  successBeep();
  servicePeltierTemperatureControl();
}

// Long press toggles lock/unlock, but only after Peltier control is disabled.
void handleLockLongPress() {
  if (peltierControlEnabled || peltierOutputOn ||
      digitalRead(PELTIER_PIN) == LOW) {
    turnPeltierOff();
    Serial.println("Turn OFF Peltier control with a quick press first!");
    soundAlarm();
    return;
  }

  temporaryRFIDUnlock = false;

  if (doorLocked) {
    unlockDoor();
  } else {
    lockDoor();
  }

  successBeep();
}

// =====================================================
// LOCK CONTROL
// =====================================================
void lockDoor() {
  // Global safety: every lock path must first force the Peltier OFF.
  peltierControlEnabled = false;
  turnPeltierOff();

  digitalWrite(LOCK_PIN, LOCK_ACTIVE_STATE);
  doorLocked = true;

  if (trayDirection == TRAY_MOVING_OUT) {
    stopTray();
  }

  Serial.println("LOCKED");
}

void unlockDoor() {
  digitalWrite(LOCK_PIN, LOCK_INACTIVE_STATE);
  doorLocked = false;
  Serial.println("UNLOCKED");
}

// =====================================================
// RFID CONTROL
// =====================================================

void handleRFID() {
  if (!rfid.PICC_IsNewCardPresent()) {
    return;
  }

  if (!rfid.PICC_ReadCardSerial()) {
    return;
  }

  Serial.print("RFID UID: ");

  for (byte i = 0; i < rfid.uid.size; i++) {
    if (rfid.uid.uidByte[i] < 0x10) {
      Serial.print("0");
    }

    Serial.print(rfid.uid.uidByte[i], HEX);
    Serial.print(" ");
  }

  Serial.println();

  if (isAuthorizedCard()) {
    Serial.println("Authorized RFID detected");

    unlockDoor();
    peltierControlEnabled = false;
    turnPeltierOff();
    Serial.println("Peltier remains disabled until a quick button press.");

    temporaryRFIDUnlock = true;
    rfidUnlockStartTime = millis();

    successBeep();
  } else {
    Serial.println("Unauthorized RFID detected");

    soundAlarm();
  }

  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
}

bool isAuthorizedCard() {
  if (rfid.uid.size != AUTHORIZED_UID_LENGTH) {
    return false;
  }

  for (byte i = 0; i < AUTHORIZED_UID_LENGTH; i++) {
    if (rfid.uid.uidByte[i] != AUTHORIZED_UID[i]) {
      return false;
    }
  }

  return true;
}

// =====================================================
// RFID AUTO-LOCK
// =====================================================

void handleTemporaryRFIDUnlock() {
  if (!temporaryRFIDUnlock) {
    return;
  }

  if (millis() - rfidUnlockStartTime >= RFID_UNLOCK_DURATION) {
    temporaryRFIDUnlock = false;
    lockDoor();

    Serial.println("RFID unlock time finished. System locked.");
  }
}

// =====================================================
// TRAY BUTTON CONTROL
// =====================================================

void handleTrayControls() {
  static bool lastButtonState = HIGH;
  static unsigned long lastPressTime = 0;
  static bool nextDirectionIn = true; // Default direction when stopped in the middle

  bool currentButtonState = digitalRead(OUT_BUTTON_PIN);
  unsigned long now = millis();

  bool outLimitPressed = digitalRead(LIMIT_OUT_PIN) == PRESSED;
  bool inLimitPressed  = digitalRead(LIMIT_IN_PIN) == PRESSED;

  // Check for button press edge detection with debounce guard
  if (currentButtonState == LOW && lastButtonState == HIGH && (now - lastPressTime > 200)) {
    lastPressTime = now;

    if (trayDirection != TRAY_STOPPED) {
      // If moving, press stops the tray
      // Next press will move in the opposite direction of the current movement
      nextDirectionIn = (trayDirection == TRAY_MOVING_OUT);
      stopTray();
      Serial.println("Tray stopped by manual button press.");
    } else {
      // Decide target direction based on current limit switch states or toggle
      bool targetDirectionIn = nextDirectionIn;

      if (inLimitPressed) {
        targetDirectionIn = false; // Already inside, must go outside
      } else if (outLimitPressed) {
        targetDirectionIn = true;  // Already outside, must go inside
      }

      if (targetDirectionIn) {
        if (inLimitPressed) {
          Serial.println("Tray already at IN limit.");
          shortBeep();
        } else {
          moveTrayIn();
          nextDirectionIn = false; // Next toggle goes outside
        }
      } else {
        if (doorLocked) {
          soundAlarm();
          Serial.println("WARNING: Tray OUT blocked because lock is active.");
        } else if (outLimitPressed) {
          Serial.println("Tray already at OUT limit.");
          shortBeep();
        } else {
          moveTrayOut();
          nextDirectionIn = true; // Next toggle goes inside
        }
      }
    }
  }

  lastButtonState = currentButtonState;
}

// =====================================================
// LIMIT SWITCH CONTROL
// =====================================================

void handleLimitSwitches() {
  bool outLimitPressed = digitalRead(LIMIT_OUT_PIN) == PRESSED;
  bool inLimitPressed  = digitalRead(LIMIT_IN_PIN) == PRESSED;

  if (trayDirection == TRAY_MOVING_OUT && outLimitPressed) {
    stopTray();
    Serial.println("OUT limit reached. Tray stopped.");
    shortBeep();
  }

  if (trayDirection == TRAY_MOVING_IN && inLimitPressed) {
    stopTray();
    Serial.println("IN limit reached. Tray stopped.");
    shortBeep();
  }
}

// =====================================================
// MOTOR CONTROL
// =====================================================

void moveTrayOut() {
  digitalWrite(MOTOR_IN1_PIN, HIGH);
  digitalWrite(MOTOR_IN2_PIN, LOW);

  if (trayDirection != TRAY_MOVING_OUT) {
    trayDirection = TRAY_MOVING_OUT;
    Serial.println("Tray moving OUT");
  }
}

void moveTrayIn() {
  digitalWrite(MOTOR_IN1_PIN, LOW);
  digitalWrite(MOTOR_IN2_PIN, HIGH);

  if (trayDirection != TRAY_MOVING_IN) {
    trayDirection = TRAY_MOVING_IN;
    Serial.println("Tray moving IN");
  }
}

void stopTray() {
  digitalWrite(MOTOR_IN1_PIN, LOW);
  digitalWrite(MOTOR_IN2_PIN, LOW);

  trayDirection = TRAY_STOPPED;
}

// =====================================================
// BUZZER CONTROL
// =====================================================

void soundAlarm() {
  // Avoid repeatedly restarting the alarm every loop.
  if (!buzzerActive) {
    digitalWrite(BUZZER_PIN, HIGH);
    digitalWrite(ALARM_LED1_PIN, HIGH);
    digitalWrite(ALARM_LED2_PIN, HIGH);
    buzzerStartTime = millis();
    buzzerActive = true;
  }
}

void handleBuzzer() {
  if (buzzerActive &&
      millis() - buzzerStartTime >= ALARM_DURATION) {

    digitalWrite(BUZZER_PIN, LOW);
    digitalWrite(ALARM_LED1_PIN, LOW);
    digitalWrite(ALARM_LED2_PIN, LOW);
    buzzerActive = false;
  }
}

void shortBeep() {
  tone(BUZZER_PIN, 1500, 150);
}

void successBeep() {
  tone(BUZZER_PIN, 2200, 300);
}

// =====================================================
// NEW HEATING SYSTEM
// =====================================================

void serviceWeightSensor() {
  unsigned long now = millis();
  if (now - lastWeightReadMs >= 500UL) {
    if (scale.is_ready()) {
      float w = scale.get_units(1);
      latestWeight = w;
    }
    lastWeightReadMs = now;
  }
}

void serviceNewTempSensors() {
  unsigned long now = millis();
  if (!tempRequestPending) {
    if (now - lastTempRequestMs >= 2000UL) {
      topTempSensor.requestTemperatures();
      bottomTempSensor.requestTemperatures();
      lastTempRequestMs = now;
      tempRequestPending = true;
    }
  } else {
    if (now - lastTempRequestMs >= 750UL) {
      float t = topTempSensor.getTempCByIndex(0);
      if (validTemperature(t)) {
        latestTopTemp = t;
      }
      float b = bottomTempSensor.getTempCByIndex(0);
      if (validTemperature(b)) {
        latestBottomTemp = b;
      }
      tempRequestPending = false;
    }
  }
}

void handleNewHeatingButton() {
  static bool lastButtonState = HIGH;
  static unsigned long lastPressTime = 0;
  bool currentButtonState = digitalRead(NEW_HEATING_BUTTON_PIN);
  unsigned long now = millis();

  if (currentButtonState == LOW && lastButtonState == HIGH && (now - lastPressTime > 200)) {
    lastPressTime = now;

    if (newHeatingState == NEW_HEATING_OFF) {
      // Get starting weight using average of 5 readings for precision
      if (scale.is_ready()) {
        startWeight = scale.get_units(5);
      } else {
        startWeight = latestWeight;
      }
      targetWeight = startWeight * HEATING_WEIGHT_PERCENTAGE;

      newHeatingState = NEW_HEATING_TOP;
      digitalWrite(TOP_PTC_PIN, PTC_ACTIVE);
      digitalWrite(BOTTOM_PTC_PIN, PTC_INACTIVE);
      digitalWrite(NEW_FAN_PIN, FAN_ACTIVE);
      Serial.print("New Heating: TOP started. Start weight: ");
      Serial.print(startWeight);
      Serial.print("g, Target weight: ");
      Serial.print(targetWeight);
      Serial.println("g");
      
      // Stop air cleaning if it was running
      if (airCleanActive) {
        stopAirCleaning();
      }
    } else {
      newHeatingState = NEW_HEATING_OFF;
      digitalWrite(TOP_PTC_PIN, PTC_INACTIVE);
      digitalWrite(BOTTOM_PTC_PIN, PTC_INACTIVE);
      digitalWrite(NEW_FAN_PIN, FAN_INACTIVE);
      Serial.println("New Heating: STOPPED manually");
      startAirCleaning(); // Start 30sec air cleaning
    }
    sendTelemetry(true);
  }
  lastButtonState = currentButtonState;
}

void serviceNewHeatingSystem() {
  handleNewHeatingButton();
  serviceWeightSensor();
  serviceNewTempSensors();

  if (newHeatingState != NEW_HEATING_OFF) {
    // If target weight is reached, stop the entire heating system
    if (latestWeight <= targetWeight) {
      newHeatingState = NEW_HEATING_OFF;
      digitalWrite(TOP_PTC_PIN, PTC_INACTIVE);
      digitalWrite(BOTTOM_PTC_PIN, PTC_INACTIVE);
      digitalWrite(NEW_FAN_PIN, FAN_INACTIVE);
      Serial.print("New Heating: COMPLETED by weight target reached (");
      Serial.print(latestWeight);
      Serial.println("g).");
      sendTelemetry(true);
      startAirCleaning(); // Start 30sec air cleaning
      return;
    }
  }

  if (newHeatingState == NEW_HEATING_TOP) {
    if (latestTopTemp > 90.0) {
      digitalWrite(TOP_PTC_PIN, PTC_INACTIVE);
      digitalWrite(BOTTOM_PTC_PIN, PTC_ACTIVE);
      newHeatingState = NEW_HEATING_BOTTOM;
      Serial.println("New Heating: TOP reached 90C. Switched to BOTTOM.");
      sendTelemetry(true);
    }
  } else if (newHeatingState == NEW_HEATING_BOTTOM) {
    if (latestBottomTemp > 90.0) {
      digitalWrite(BOTTOM_PTC_PIN, PTC_INACTIVE);
      digitalWrite(NEW_FAN_PIN, FAN_INACTIVE);
      newHeatingState = NEW_HEATING_OFF;
      Serial.println("New Heating: BOTTOM reached 90C safety limit. Stopped.");
      sendTelemetry(true);
      startAirCleaning(); // Start 30sec air cleaning
    }
  }
}

// =====================================================
// LCD DISPLAY FUNCTIONS
// =====================================================

void updateLCD() {
  static float lastLcdHum = -999.0;
  static float lastLcdTemp = -999.0;

  // Only update LCD when temp or humidity changes to avoid flicker
  if (latestHumidity != lastLcdHum || latestMainTemperature != lastLcdTemp) {
    lastLcdHum = latestHumidity;
    lastLcdTemp = latestMainTemperature;

    lcd.setCursor(0, 0);
    lcd.print("Temp: ");
    if (isnan(latestMainTemperature)) {
      lcd.print("Error   ");
    } else {
      lcd.print(latestMainTemperature, 1);
      lcd.print((char)223); // Degree symbol
      lcd.print("C   ");
    }

    lcd.setCursor(0, 1);
    lcd.print("Hum:  ");
    if (isnan(latestHumidity)) {
      lcd.print("Error   ");
    } else {
      lcd.print(latestHumidity, 1);
      lcd.print("%   ");
    }
  }
}

// =====================================================
// AIR CLEANING FUNCTIONS
// =====================================================

void startAirCleaning() {
  digitalWrite(AIR_CLEAN_FAN_PIN, AIR_CLEAN_FAN_ACTIVE);
  airCleanStartMs = millis();
  airCleanActive = true;
  Serial.println("Air Cleaning: STARTED");
}

void stopAirCleaning() {
  digitalWrite(AIR_CLEAN_FAN_PIN, AIR_CLEAN_FAN_INACTIVE);
  airCleanActive = false;
  Serial.println("Air Cleaning: STOPPED");
}

void serviceAirCleaning() {
  if (airCleanActive) {
    if (millis() - airCleanStartMs >= AIR_CLEAN_TIME) {
      stopAirCleaning();
    }
  }
}
