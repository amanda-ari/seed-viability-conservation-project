// ==================================================
// SETUP
// ==================================================
void setup() {
  Serial.begin(9600);
  Serial1.begin(NODEMCU_BAUD);

  // Initialize LCD
  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("System Ready");

  // ---------------- Lock / RFID / manual tray setup ----------------
  pinMode(LOCK_PIN, OUTPUT);
  pinMode(PELTIER_PIN, OUTPUT);

  // Peltier relay is active LOW. Start safely OFF, then enable
  // automatic control after all system states are initialized.
  digitalWrite(PELTIER_PIN, HIGH);
  peltierOutputOn = false;

  lockPeltierButton.attachClick(handlePeltierQuickPress);
  lockPeltierButton.attachLongPressStart(handleLockLongPress);
  lockPeltierButton.setPressMs(2000);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  pinMode(ALARM_LED1_PIN, OUTPUT);
  pinMode(ALARM_LED2_PIN, OUTPUT);
  digitalWrite(ALARM_LED1_PIN, LOW);
  digitalWrite(ALARM_LED2_PIN, LOW);

  pinMode(MOTOR_IN1_PIN, OUTPUT);
  pinMode(MOTOR_IN2_PIN, OUTPUT);
  stopTray();

  pinMode(LIMIT_OUT_PIN, INPUT_PULLUP);
  pinMode(LIMIT_IN_PIN, INPUT_PULLUP);
  pinMode(OUT_BUTTON_PIN, INPUT_PULLUP);
  pinMode(NEW_HEATING_BUTTON_PIN, INPUT_PULLUP);

  pinMode(TOP_PTC_PIN, OUTPUT);
  pinMode(BOTTOM_PTC_PIN, OUTPUT);
  pinMode(NEW_FAN_PIN, OUTPUT);
  pinMode(AIR_CLEAN_FAN_PIN, OUTPUT);
  digitalWrite(TOP_PTC_PIN, PTC_INACTIVE);
  digitalWrite(BOTTOM_PTC_PIN, PTC_INACTIVE);
  digitalWrite(NEW_FAN_PIN, FAN_INACTIVE);
  digitalWrite(AIR_CLEAN_FAN_PIN, AIR_CLEAN_FAN_INACTIVE);

  topTempSensor.begin();
  bottomTempSensor.begin();
  topTempSensor.setWaitForConversion(false);
  bottomTempSensor.setWaitForConversion(false);

  // Initialize HX711 scale
  scale.begin(HX711_DT_PIN, HX711_SCK_PIN);
  scale.set_scale(SCALE_CALIBRATION_FACTOR);
  scale.set_offset(SCALE_OFFSET);

  SPI.begin();
  rfid.PCD_Init();

  // Start electronic lock unlocked and allow automatic Peltier control.
  unlockDoor();
  peltierControlEnabled = false;
  auxiliaryControlsReady = true;

  pinMode(DEFAULT_MOTOR_IN3, OUTPUT);
  pinMode(DEFAULT_MOTOR_IN4, OUTPUT);
  pinMode(STANDBY_MOTOR_IN3, OUTPUT);
  pinMode(STANDBY_MOTOR_IN4, OUTPUT);

  pinMode(DEFAULT_LIMIT_OUT, INPUT_PULLUP);
  pinMode(DEFAULT_LIMIT_IN, INPUT_PULLUP);
  pinMode(STANDBY_LIMIT_OUT, INPUT_PULLUP);
  pinMode(STANDBY_LIMIT_IN, INPUT_PULLUP);

  pinMode(DEFAULT_PTC_PIN, OUTPUT);
  pinMode(DEFAULT_FAN_PIN, OUTPUT);
  pinMode(STANDBY_PTC_PIN, OUTPUT);
  pinMode(STANDBY_FAN_PIN, OUTPUT);

  dht.begin();
  defaultTempSensor.begin();
  standbyTempSensor.begin();

  defaultServo.attach(DEFAULT_SERVO_PIN);
  standbyServo.attach(STANDBY_SERVO_PIN);

  defaultServo.write(DEFAULT_DOOR_CLOSED);
  standbyServo.write(STANDBY_DOOR_CLOSED);

  stopDefaultMotor();
  stopStandbyMotor();
  stopDefaultHeating();
  stopStandbyHeating();

  Serial.println("======================================");
  Serial.println("Dual Silica-Gel Controller Started");
  Serial.println("Heating calculation: servo-open time based");
  Serial.print("Peltier temperature threshold: ");
  Serial.print(PELTIER_TEMP_THRESHOLD, 1);
  Serial.println(" C");
  Serial.println("Quick press: disable/enable automatic Peltier control");
  Serial.println("Long press: lock/unlock only while Peltier is OFF");
  Serial.print("Heating multiplier: ");
  Serial.println(HEATING_TIME_MULTIPLIER, 2);
  Serial.println("Authorized RFID: BC 32 AB 04");
  Serial.println("Manual tray and lock controls enabled");
  Serial.println("======================================");

  responsiveDelay(1000);
  homeBothTrays();
  sendTelemetry(true);
}

// ==================================================
// MAIN LOOP
// ==================================================
void loop() {
  serviceAuxiliaryControls();
  enforceHeatingInterlock();

  if (digitalRead(DEFAULT_LIMIT_IN) != LOW ||
      digitalRead(STANDBY_LIMIT_IN) != LOW) {
    homeBothTrays();
    return;
  }

  stopDefaultMotor();
  stopStandbyMotor();

  float humidity = readHumidity();

  if (isnan(humidity)) {
    Serial.println("ERROR: DHT22 humidity read failed");
    ensureBothDoorsClosed();
    telemetryDelay(HUMIDITY_CHECK_TIME);
    return;
  }

  latestHumidity = humidity;
  sendTelemetry(false);

  Serial.println("--------------------------------------");
  Serial.print("Current humidity: ");
  Serial.print(humidity, 2);
  Serial.println(" %");

  if (humidity > HUM_THRESHOLD) {
    runCompleteDualCycle();
  } else {
    ensureBothDoorsClosed();
    Serial.println("Humidity is at or below threshold");
    telemetryDelay(HUMIDITY_CHECK_TIME);
  }
}

// ==================================================
// COMPLETE DUAL CYCLE
// ==================================================
void runCompleteDualCycle() {
  Serial.println("Starting DEFAULT humidity reduction");

  // Keep default door open until humidity reaches threshold.
  unsigned long defaultOpenMs =
      runDefaultHumidityReduction();

  if (defaultOpenMs == 0) {
    Serial.println("DEFAULT humidity reduction aborted");
    return;
  }

  defaultServoOpenTimeSec = defaultOpenMs / 1000.0;
  defaultRequiredHeatingSec =
      calculateHeatingSeconds(defaultOpenMs);

  printHeatingCalculation(
      "DEFAULT",
      defaultServoOpenTimeSec,
      defaultRequiredHeatingSec
  );

  closeDefaultDoorSmoothly();
  defaultDoorOpen = false;
  responsiveDelay(AFTER_DOOR_CLOSE_TIME);

  Serial.println("Moving DEFAULT tray OUT");
  moveDefaultOut();

  if (!waitForLimit(DEFAULT_LIMIT_OUT,
                    MOTOR_TRAVEL_TIMEOUT,
                    "DEFAULT OUT")) {
    stopDefaultMotor();
    stopDefaultHeating();
    homeBothTrays();
    return;
  }

  stopDefaultMotor();
  responsiveDelay(LIMIT_SETTLE_TIME);

  // Standby may control humidity only while default is heating.
  prepareStandbyHumidityControl();

  bool defaultHeatingCompleted =
      runDefaultTimedHeating(defaultRequiredHeatingSec * 1000UL);

  Serial.println("Moving DEFAULT tray IN");
  moveDefaultIn();

  bool defaultReturnedIn =
      waitForLimit(DEFAULT_LIMIT_IN,
                   MOTOR_TRAVEL_TIMEOUT,
                   "DEFAULT IN");

  stopDefaultMotor();

  if (!defaultReturnedIn) {
    stopDefaultHeating();
    stopStandbyHeating();
    returnStandbyToHumidityControl();
    return;
  }

  responsiveDelay(LIMIT_SETTLE_TIME);

  // If standby is still open, continue until humidity reaches target.
  if (standbyExposureUsed && standbyDoorOpen) {
    finishStandbyHumidityReduction();
  }

  if (standbyExposureUsed) {
    if (standbyExposureDurationMs == 0) {
      standbyExposureDurationMs = millis() - standbyDoorOpenedAtMs;
    }

    standbyServoOpenTimeSec =
        standbyExposureDurationMs / 1000.0;

    standbyRequiredHeatingSec =
        calculateHeatingSeconds(standbyExposureDurationMs);

    printHeatingCalculation(
        "STANDBY",
        standbyServoOpenTimeSec,
        standbyRequiredHeatingSec
    );

    if (standbyDoorOpen) {
      closeStandbyDoorSmoothly();
      standbyDoorOpen = false;
    }

    responsiveDelay(AFTER_DOOR_CLOSE_TIME);

    if (defaultHeatingCompleted &&
        digitalRead(DEFAULT_LIMIT_IN) == LOW &&
        !defaultHeatingActive &&
        digitalRead(DEFAULT_PTC_PIN) == HIGH) {

      Serial.println("Moving STANDBY tray OUT");
      moveStandbyOut();

      if (!waitForLimit(STANDBY_LIMIT_OUT,
                        MOTOR_TRAVEL_TIMEOUT,
                        "STANDBY OUT")) {
        stopStandbyMotor();
        stopStandbyHeating();
        returnStandbyToHumidityControl();
        return;
      }

      stopStandbyMotor();
      responsiveDelay(LIMIT_SETTLE_TIME);

      bool standbyHeatingCompleted =
          runStandbyTimedHeating(
              standbyRequiredHeatingSec * 1000UL
          );

      Serial.println("Moving STANDBY tray IN");
      moveStandbyIn();

      waitForLimit(STANDBY_LIMIT_IN,
                   MOTOR_TRAVEL_TIMEOUT,
                   "STANDBY IN");

      stopStandbyMotor();
      responsiveDelay(LIMIT_SETTLE_TIME);

      Serial.println(
          standbyHeatingCompleted
          ? "STANDBY heating completed"
          : "STANDBY heating interrupted"
      );
    }
  }

  stopDefaultHeating();
  stopStandbyHeating();
  standbyExposureUsed = false;

  Serial.println("Dual cycle completed");
  sendTelemetry(true);
}

// ==================================================
// DEFAULT HUMIDITY REDUCTION
// Door remains open until humidity <= threshold.
// ==================================================
unsigned long runDefaultHumidityReduction() {
  openDefaultDoorSmoothly();
  defaultDoorOpen = true;

  unsigned long openedAt = millis();

  while (true) {
    serviceAuxiliaryControls();
    unsigned long openDuration = millis() - openedAt;

    if (openDuration >= MAX_DOOR_OPEN_TIME) {
      Serial.println("WARNING: DEFAULT maximum door-open time reached");
      return openDuration;
    }

    float humidity = readHumidity();

    if (isnan(humidity)) {
      Serial.println("ERROR: DHT22 failed while DEFAULT door was open");
      closeDefaultDoorSmoothly();
      defaultDoorOpen = false;
      return 0;
    }

    latestHumidity = humidity;

    Serial.print("DEFAULT door open - humidity: ");
    Serial.print(humidity, 2);
    Serial.println(" %");

    sendTelemetry(false);

    if (humidity <= HUM_THRESHOLD) {
      Serial.println("Humidity reached threshold");
      return millis() - openedAt;
    }
  }
}

// ==================================================
// STANDBY HUMIDITY CONTROL
// ==================================================
void prepareStandbyHumidityControl() {
  float humidity = readHumidity();

  if (!isnan(humidity)) {
    latestHumidity = humidity;
  }

  if (!isnan(humidity) && humidity > HUM_THRESHOLD) {
    Serial.println("Opening STANDBY door during DEFAULT heating");
    openStandbyDoorSmoothly();
    standbyDoorOpen = true;
    standbyExposureUsed = true;
    standbyDoorOpenedAtMs = millis();
    standbyExposureDurationMs = 0;
  } else {
    closeStandbyDoorSmoothly();
    standbyDoorOpen = false;
    standbyExposureUsed = false;
  }
}

void monitorStandbyHumidityDuringDefaultHeating() {
  if (!standbyExposureUsed || !standbyDoorOpen) {
    return;
  }

  if (millis() - standbyDoorOpenedAtMs >= MAX_DOOR_OPEN_TIME) {
    Serial.println("WARNING: STANDBY maximum door-open time reached");
    standbyExposureDurationMs = millis() - standbyDoorOpenedAtMs;
    closeStandbyDoorSmoothly();
    standbyDoorOpen = false;
    return;
  }

  float humidity = readHumidity();

  if (isnan(humidity)) {
    Serial.println("ERROR: DHT22 failed while STANDBY door was open");
    closeStandbyDoorSmoothly();
    standbyDoorOpen = false;
    return;
  }

  latestHumidity = humidity;

  Serial.print("STANDBY door open - humidity: ");
  Serial.print(humidity, 2);
  Serial.println(" %");

  if (humidity <= HUM_THRESHOLD) {
    Serial.println("Humidity reached threshold; closing STANDBY door");
    standbyExposureDurationMs = millis() - standbyDoorOpenedAtMs;
    closeStandbyDoorSmoothly();
    standbyDoorOpen = false;
  }
}

void finishStandbyHumidityReduction() {
  while (standbyDoorOpen) {
    serviceAuxiliaryControls();
    if (millis() - standbyDoorOpenedAtMs >= MAX_DOOR_OPEN_TIME) {
      Serial.println("WARNING: STANDBY maximum door-open time reached");
      break;
    }

    float humidity = readHumidity();

    if (isnan(humidity)) {
      Serial.println("ERROR: DHT22 failed during STANDBY control");
      break;
    }

    latestHumidity = humidity;
    sendTelemetry(false);

    Serial.print("Waiting for humidity threshold: ");
    Serial.print(humidity, 2);
    Serial.println(" %");

    if (humidity <= HUM_THRESHOLD) {
      break;
    }
  }

  standbyExposureDurationMs = millis() - standbyDoorOpenedAtMs;
  closeStandbyDoorSmoothly();
  standbyDoorOpen = false;
}

// ==================================================
// TIME CALCULATION
// ==================================================
unsigned long calculateHeatingSeconds(unsigned long servoOpenMs) {
  float servoOpenSeconds = servoOpenMs / 1000.0;
  float calculatedSeconds =
      servoOpenSeconds * HEATING_TIME_MULTIPLIER;

  if (calculatedSeconds < 1.0) {
    calculatedSeconds = 1.0;
  }

  unsigned long maxSeconds =
      MAX_HEATING_PROCESS_TIME / 1000UL;

  if (calculatedSeconds > maxSeconds) {
    calculatedSeconds = maxSeconds;
  }

  return (unsigned long)(calculatedSeconds + 0.5);
}

void printHeatingCalculation(
    const char* systemName,
    float servoOpenSeconds,
    unsigned long heatingSeconds) {

  Serial.println("--------------------------------------");
  Serial.print(systemName);
  Serial.println(" HEATING CALCULATION");

  Serial.print("Servo open time: ");
  Serial.print(servoOpenSeconds, 2);
  Serial.println(" seconds");

  Serial.print("Heating multiplier: ");
  Serial.println(HEATING_TIME_MULTIPLIER, 2);

  Serial.print("Calculated heating time: ");
  Serial.print(heatingSeconds);
  Serial.println(" seconds");
}

// ==================================================
// DEFAULT TIMED HEATING
// Cooling time is not counted as active heating time.
// ==================================================
bool runDefaultTimedHeating(unsigned long requiredHeatingMs) {
  if (requiredHeatingMs == 0) {
    return true;
  }

  requiredHeatingMs =
      min(requiredHeatingMs, MAX_HEATING_PROCESS_TIME);

  defaultHeatingStartedMs = millis();
  defaultHeatingElapsedSec = 0;
  defaultHeatingRemainingSec = requiredHeatingMs / 1000UL;

  unsigned long accumulatedHeatingMs = 0;
  unsigned long heaterOnStartedAt = millis();
  unsigned long lastStandbyHumidityCheck = 0;

  startDefaultHeating();
  sendTelemetry(true);

  Serial.println("DEFAULT timed heating started");

  while (accumulatedHeatingMs < requiredHeatingMs) {
    serviceAuxiliaryControls();
    enforceHeatingInterlock();

    if (!defaultHeatingActive) {
      Serial.println("DEFAULT heating stopped unexpectedly");
      return false;
    }

    unsigned long now = millis();
    accumulatedHeatingMs += now - heaterOnStartedAt;
    heaterOnStartedAt = now;

    defaultHeatingElapsedSec = accumulatedHeatingMs / 1000UL;
    unsigned long defaultRemainingMs =
        accumulatedHeatingMs >= requiredHeatingMs
        ? 0
        : requiredHeatingMs - accumulatedHeatingMs;

    defaultHeatingRemainingSec =
        (long)((defaultRemainingMs + 999UL) / 1000UL);

    float temperature = readDefaultTemperature();
    defaultTemperatureTelemetry = temperature;

    if (!validTemperature(temperature)) {
      stopDefaultHeating();
      Serial.println("ERROR: DEFAULT temperature sensor failed");
      sendTelemetry(true);
      return false;
    }

    if (temperature > PTC_TEMP_THRESHOLD) {
      stopDefaultHeating();
      Serial.println("DEFAULT over-temperature; cooling");
      sendTelemetry(true);
      telemetryDelay(PTC_COOLING_TIME);
      startDefaultHeating();
      heaterOnStartedAt = millis();
    }

    if (standbyDoorOpen &&
        millis() - lastStandbyHumidityCheck >= HUMIDITY_CHECK_TIME) {
      lastStandbyHumidityCheck = millis();
      monitorStandbyHumidityDuringDefaultHeating();
    }

    sendTelemetry(false);
    responsiveDelay(50);
  }

  defaultHeatingElapsedSec = requiredHeatingMs / 1000UL;
  defaultHeatingRemainingSec = 0;
  stopDefaultHeating();
  sendTelemetry(true);

  Serial.println("DEFAULT timed heating completed");
  return true;
}

// ==================================================
// STANDBY TIMED HEATING
// ==================================================
bool runStandbyTimedHeating(unsigned long requiredHeatingMs) {
  if (requiredHeatingMs == 0) {
    return true;
  }

  if (defaultHeatingActive ||
      digitalRead(DEFAULT_PTC_PIN) == LOW ||
      digitalRead(DEFAULT_LIMIT_IN) != LOW) {
    Serial.println("STANDBY heating blocked by interlock");
    stopStandbyHeating();
    return false;
  }

  requiredHeatingMs =
      min(requiredHeatingMs, MAX_HEATING_PROCESS_TIME);

  standbyHeatingStartedMs = millis();
  standbyHeatingElapsedSec = 0;
  standbyHeatingRemainingSec = requiredHeatingMs / 1000UL;

  unsigned long accumulatedHeatingMs = 0;
  unsigned long heaterOnStartedAt = millis();

  startStandbyHeating();
  sendTelemetry(true);

  Serial.println("STANDBY timed heating started");

  while (accumulatedHeatingMs < requiredHeatingMs) {
    serviceAuxiliaryControls();
    if (defaultHeatingActive ||
        digitalRead(DEFAULT_PTC_PIN) == LOW) {
      Serial.println("EMERGENCY: stopping STANDBY heating");
      stopStandbyHeating();
      sendTelemetry(true);
      return false;
    }

    enforceHeatingInterlock();

    if (!standbyHeatingActive) {
      return false;
    }

    unsigned long now = millis();
    accumulatedHeatingMs += now - heaterOnStartedAt;
    heaterOnStartedAt = now;

    standbyHeatingElapsedSec = accumulatedHeatingMs / 1000UL;
    unsigned long standbyRemainingMs =
        accumulatedHeatingMs >= requiredHeatingMs
        ? 0
        : requiredHeatingMs - accumulatedHeatingMs;

    standbyHeatingRemainingSec =
        (long)((standbyRemainingMs + 999UL) / 1000UL);

    float temperature = readStandbyTemperature();
    standbyTemperatureTelemetry = temperature;

    if (!validTemperature(temperature)) {
      stopStandbyHeating();
      Serial.println("ERROR: STANDBY temperature sensor failed");
      sendTelemetry(true);
      return false;
    }

    if (temperature > PTC_TEMP_THRESHOLD) {
      stopStandbyHeating();
      Serial.println("STANDBY over-temperature; cooling");
      sendTelemetry(true);
      telemetryDelay(PTC_COOLING_TIME);

      if (defaultHeatingActive ||
          digitalRead(DEFAULT_PTC_PIN) == LOW) {
        return false;
      }

      startStandbyHeating();
      heaterOnStartedAt = millis();
    }

    sendTelemetry(false);
    responsiveDelay(50);
  }

  standbyHeatingElapsedSec = requiredHeatingMs / 1000UL;
  standbyHeatingRemainingSec = 0;
  stopStandbyHeating();
  sendTelemetry(true);

  Serial.println("STANDBY timed heating completed");
  return true;
}

